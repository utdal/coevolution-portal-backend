# Ignore large or unnecessary local files and folders during build

# Python cache and compiled files
__pycache__/
*.pyc
*.pyo
*.pyd
*.pyc
*.pyo
*.pyd

# Django-specific
*.log
*.sqlite3
*.pot
*.pyc
*.pyo
db.sqlite3

# Ignore local media/uploads if you have them
media/
uploads/

# Node-related (if using npm/yarn in frontend)
node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log

# MacOS / IDE junk
.DS_Store
.vscode/
.idea/

# Git
.git/
.gitignore

# Docker build should ignore the big DB file
databases/
media/